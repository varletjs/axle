{
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "bootstrap": "pnpm i && pnpm build",
    "build": "pnpm --dir ./packages/axle build",
    "clean": "rimraf ./node_modules ./packages/*/node_modules",
    "dev": "pnpm --dir ./packages/axle dev",
    "docs:build": "pnpm --dir ./packages/docs build",
    "docs:dev": "pnpm --dir ./packages/docs dev",
    "docs:preview": "pnpm --dir ./packages/docs preview",
    "lint": "vp lint --fix",
    "format": "vp fmt",
    "preinstall": "npx only-allow pnpm",
    "prepare": "vp config --hooks-dir .vite-hooks",
    "release": "pnpm build && vr release"
  },
  "devDependencies": {
    "@varlet/release": "^1.1.0",
    "rattail": "^1.8.1",
    "rimraf": "^5.0.1",
    "typescript": "5.3.3",
    "vite-plus": "^0.1.16"
  },
  "engines": {
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.0.0"
}
